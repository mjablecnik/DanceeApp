OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.0-flash-001
IMAGE_GENERATION_MODEL=black-forest-labs/flux.2-pro
DIRECTUS_BASE_URL=http://localhost:8055
DIRECTUS_ACCESS_TOKEN=your_directus_access_token_here
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
SENTRY_DSN=
CORS_ORIGINS=*
APP_PORT=9080
DIRECTUS_TIMEOUT_MS=30000
NOMINATIM_TIMEOUT_MS=10000
LLM_TEMPERATURE=0.1

# Email address to receive contact form notifications
AUTHOR_EMAIL=your_email_here

# Facebook authenticated scraping — raw cookie string from a logged-in session.
# Get c_user and xs values from your browser's Facebook cookies.
# Format: "c_user=YOUR_USER_ID; xs=YOUR_XS_TOKEN"
FB_COOKIES=
# Minimum delay in ms between consecutive Facebook scrape requests (default 4000).
SCRAPE_DELAY_MIN_MS=4000
# Maximum delay in ms between consecutive Facebook scrape requests (default 10000).
SCRAPE_DELAY_MAX_MS=10000
