{
  "name": "directus-extension-firebase-auth",
  "version": "1.0.0",
  "description": "Firebase Auth integration for Directus — verifies Firebase JWTs and manages Directus user accounts.",
  "directus:extension": {
    "type": "bundle",
    "path": {
      "api": "dist/index.js"
    },
    "entries": [
      {
        "type": "hook",
        "name": "firebase-init",
        "source": "dist/hook.js"
      },
      {
        "type": "endpoint",
        "name": "firebase",
        "source": "dist/endpoint.js"
      }
    ]
  }
}
